# Every variable is read through lib/env.ts (server) or lib/env-public.ts
# (browser), which TRIM and treat an empty value as absent. A dashboard row
# created without a value arrives as an empty string, not undefined — that is
# why "" must never count as configured.

# ── The Monza CRM Supabase project (staff identity) ──────────────────────────
# Staff sign in against THIS project, and the CRM connector queries it with the
# signed-in user's own token, so CRM RLS applies to every AI answer.
#
# Setting BOTH of these switches the deployment out of demo mode: the sign-in
# gate turns on, and anything touching real shared infrastructure (the media
# library today) starts requiring a real staff identity instead of refusing.
NEXT_PUBLIC_CRM_SUPABASE_URL=
NEXT_PUBLIC_CRM_SUPABASE_ANON_KEY=

# ── MONZA AI's own database (conversations, automations, audit, media) ───────
# A SEPARATE Supabase project. Never the CRM one.
#
# The URL and anon key are PUBLIC by design and have committed defaults in
# lib/env-public.ts, so the shared media library stays readable without any
# dashboard configuration. Setting them here overrides those defaults; the
# admin view of /api/status reports which of the two is actually in use.
NEXT_PUBLIC_AI_SUPABASE_URL=
NEXT_PUBLIC_AI_SUPABASE_ANON_KEY=

# The SECRET. No fallback exists, and nothing in this repository can stand in
# for it. Server-only: it is never sent to a browser, and no response ever
# reveals its value, its length or whether it merely looks wrong.
AI_SUPABASE_SERVICE_ROLE_KEY=

# ── The brain ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Overrides the assistant's model. The ai_settings row still wins over this.
MONZA_AI_MODEL=
